<?xml version='1.0' encoding='utf-8'?>
<widget id="com.mola.starweave" version="1.0.5" android-versionCode="10005"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Starweave</name>
    <description>让每个智能体，与世界相连</description>
    <author>Mola</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="Orientation" value="default" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="0xff0b1020" />
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/splash-empty.xml" />
    <preference name="AndroidWindowSplashScreenBackground" value="#0b1020" />
    <preference name="AndroidWindowSplashScreenIconBackgroundColor" value="#0b1020" />
    <preference name="FadeSplashScreen" value="false" />
    <preference name="SplashScreenDelay" value="0" />
    <hook type="after_prepare" src="hooks/android-chrome.js" />
    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />
        <preference name="android-compileSdkVersion" value="34" />
        <preference name="AndroidInsecureFileModeEnabled" value="false" />
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" android:allowBackup="false" />
        </edit-config>
        <icon src="res/icon.png" />
    </platform>
</widget>
